<Application x:Class="CofreDeSegredos.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F8F7F4"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1A1C1E"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#76757A"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E9E4DE"/>
    <SolidColorBrush x:Key="GoldBrush" Color="#C5A059"/>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
